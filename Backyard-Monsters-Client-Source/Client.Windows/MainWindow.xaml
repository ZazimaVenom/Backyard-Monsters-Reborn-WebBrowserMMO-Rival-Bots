<Window x:Class="BackyardMonsters.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Backyard Monsters · Reborn" Icon="Art/app.ico" Width="1360" Height="900"
        MinWidth="1080" MinHeight="700" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" Background="#101F1C"
        Foreground="#EDF1E5" FontFamily="Segoe UI" UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="62" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#EDF1E5"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#91A49A"/>
        <SolidColorBrush x:Key="LimeBrush" Color="#D1E7A1"/>
        <SolidColorBrush x:Key="LineBrush" Color="#30463B"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#A6BD9F"/>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#20382F"/>
            <Setter Property="Foreground" Value="#EDF1E5"/>
            <Setter Property="BorderBrush" Value="#5B7353"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="Background" Value="#20352C"/>
            <Setter Property="Foreground" Value="#D8E1CE"/>
            <Setter Property="BorderBrush" Value="#3B5040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.8"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.6"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#F5E6BC"/><Setter TargetName="Face" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}"/>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="#D1E7A1"/>
            <Setter Property="Foreground" Value="#243B28"/>
            <Setter Property="BorderBrush" Value="#E5F1C6"/>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A5B99F"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Foreground" Value="#EDF1E5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#344D39"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#D1E7A1"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#EDF1E5"/>
            <Setter Property="Background" Value="#10231C"/>
            <Setter Property="BorderBrush" Value="#496042"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7"/>
                            <TextBox x:Name="PART_EditableTextBox" Margin="13,0,38,0" Padding="0" Background="Transparent" BorderThickness="0"
                                     Foreground="{TemplateBinding Foreground}" CaretBrush="#D1E7A1" SelectionBrush="#496840"
                                     VerticalContentAlignment="Center" FontSize="{TemplateBinding FontSize}"
                                     IsReadOnly="{TemplateBinding IsReadOnly}" FocusVisualStyle="{x:Null}"
                                     Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Background="Transparent" VerticalAlignment="Center"/></ControlTemplate></TextBox.Template>
                            </TextBox>
                            <ToggleButton Width="34" HorizontalAlignment="Right" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          AutomationProperties.Name="Show saved servers">
                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><Path Data="M 0,0 L 4,4 L 8,0" Stroke="#B6CCA3" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#182E24" BorderBrush="#496042" BorderThickness="1" CornerRadius="6" Padding="5" Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260">
                                    <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#D1E7A1"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#B6C7AE"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CheckBorder" Width="16" Height="16" CornerRadius="4" BorderBrush="#6C835A" BorderThickness="1" Background="#152B20" Margin="0,0,8,0">
                                <Path x:Name="CheckMark" Data="M 2,6 L 5,9 L 11,3" Stroke="#233A24" StrokeThickness="2" Margin="1" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckBorder" Property="Background" Value="#D1E7A1"/><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckBorder" Property="BorderBrush" Value="#F5E6BC"/><Setter TargetName="CheckBorder" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#405039" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="62"/>
                <RowDefinition Height="76"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto" MinHeight="66"/>
            </Grid.RowDefinitions>
            <!-- The title bar remains native, trusted UI above the remote game. -->
            <Border Grid.Row="0" Background="#152723" BorderBrush="#2C4034" BorderThickness="0,0,0,1">
                <Grid Margin="22,0,10,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="49" Height="45" Margin="0,0,12,0">
                            <TextBlock Text="B" FontFamily="Georgia" FontSize="43" FontWeight="Bold" Foreground="#D1E7A1" Margin="0,-4,0,0"/>
                            <TextBlock Text="M" FontFamily="Georgia" FontSize="27" FontWeight="Bold" Foreground="#90B078" Margin="20,15,0,0"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="BACKYARD MONSTERS" FontSize="13" FontWeight="ExtraBold"/><TextBlock Text="R E B O R N   /   D E S K T O P" FontSize="8" Foreground="#E4BA71" Margin="0,5,0,0"/></StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,0">
                        <Border Background="#263A2D" BorderBrush="#40523B" BorderThickness="1" CornerRadius="5" Padding="10,5"><TextBlock Text="YOUR REALM. YOUR RULES." Foreground="#A6BD9F" FontSize="9" FontWeight="SemiBold"/></Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MuteButton" Style="{StaticResource ButtonBase}" Content="Sound on" Padding="10,7" Margin="0,0,8,0" Click="Mute_Click" ToolTip="Mute or unmute the client" AutomationProperties.Name="Mute or unmute audio"/>
                        <Button Style="{StaticResource IconButton}" Click="Fullscreen_Click" ToolTip="Toggle fullscreen (F11)" AutomationProperties.Name="Toggle fullscreen"><Path Data="M 5,0 L 0,0 L 0,5 M 10,0 L 15,0 L 15,5 M 15,10 L 15,15 L 10,15 M 5,15 L 0,15 L 0,10" Stroke="#A5B99F" StrokeThickness="1.5"/></Button>
                        <Border Width="1" Height="20" Background="#344936" Margin="9,0"/>
                        <Button Style="{StaticResource IconButton}" Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize window"><Path Data="M 0,5 L 12,5" Stroke="#A5B99F" StrokeThickness="1.5"/></Button>
                        <Button Style="{StaticResource IconButton}" Click="Maximize_Click" ToolTip="Maximize or restore" AutomationProperties.Name="Maximize or restore window"><Rectangle Width="11" Height="11" Stroke="#A5B99F" StrokeThickness="1.5"/></Button>
                        <Button Style="{StaticResource IconButton}" Foreground="#E1AB98" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close client"><Path Data="M 0,0 L 11,11 M 11,0 L 0,11" Stroke="#E1AB98" StrokeThickness="1.5"/></Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="1" Background="#192D24" BorderBrush="#344733" BorderThickness="0,0,0,1">
                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                        <Button Style="{StaticResource IconButton}" Click="Home_Click" ToolTip="Return to the launcher" AutomationProperties.Name="Launcher home"><Path Data="M 0,7 L 8,0 L 16,7 M 3,6 L 3,16 L 7,16 L 7,10 L 10,10 L 10,16 L 13,16 L 13,6" Stroke="#A5B99F" StrokeThickness="1.5" StrokeLineJoin="Round"/></Button>
                        <Button Style="{StaticResource IconButton}" Click="Reload_Click" ToolTip="Reload the game" AutomationProperties.Name="Reload game"><Path Data="M 15,6 A 7,7 0 1 0 15,11 M 15,1 L 15,6 L 10,6" Stroke="#A5B99F" StrokeThickness="1.5" StrokeLineJoin="Round"/></Button>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="REALM ADDRESS" Style="{StaticResource Eyebrow}"/><TextBlock Text="Choose your backyard" FontSize="10" Foreground="#849B89" Margin="0,5,0,0"/></StackPanel>
                    <ComboBox Grid.Column="2" x:Name="ServerBox" IsEditable="True" IsTextSearchEnabled="False" Text="127.0.0.1" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="Server address" ToolTip="Enter an IP address or web address, including a port or game folder if needed."/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Save" Click="SaveServer_Click" Margin="0,0,7,0" ToolTip="Remember this server address"/>
                        <Button Content="Forget" Click="ForgetServer_Click" Margin="0,0,12,0" ToolTip="Remove this address from saved servers"/>
                        <Button x:Name="ConnectButton" Content="Connect  →" Width="116" Style="{StaticResource PrimaryButton}" Click="Connect_Click" IsDefault="True"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="2">
                <Grid x:Name="HomePanel" Background="#101F1C">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                  CanContentScroll="False" PanningMode="VerticalOnly">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar">
                                <Setter Property="Width" Value="11"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Grid Margin="2,4" Background="Transparent">
                                                <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                                                       Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                                       ViewportSize="{TemplateBinding ViewportSize}"
                                                       Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"/></Track.DecreaseRepeatButton>
                                                    <Track.Thumb><Thumb MinHeight="26"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#526C45" CornerRadius="4"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                                                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"/></Track.IncreaseRepeatButton>
                                                </Track>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ScrollViewer.Resources>
                    <Grid Margin="36,28,36,26" MinHeight="500">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="118"/></Grid.RowDefinitions>
                        <Border BorderBrush="#354A36" BorderThickness="1" CornerRadius="15" ClipToBounds="True" Margin="0,0,0,22">
                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0.7"><GradientStop Color="#1B3227" Offset="0"/><GradientStop Color="#213B2C" Offset="0.55"/><GradientStop Color="#2B4530" Offset="1"/></LinearGradientBrush></Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="38,28,10,24" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,19"><Border Background="#D1E7A1" Width="6" Height="6" CornerRadius="3" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock Text="WELCOME TO THE WILD BACKYARD" Style="{StaticResource Eyebrow}" Foreground="#C3D9A9"/></StackPanel>
                                    <TextBlock FontSize="47" FontWeight="Bold" LineHeight="51" Text="Your backyard.&#10;Your world." Foreground="#F0F2DD"/>
                                    <TextBlock Text="Raise a little trouble. Build something wild.&#10;Your next adventure starts in a backyard." FontSize="14" LineHeight="24" Foreground="#AAC0A5" Margin="0,20,0,21" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal"><Button Content="Enter the backyard  →" Style="{StaticResource PrimaryButton}" Padding="21,12" FontSize="13" Click="Connect_Click"/><TextBlock Text="Choose a realm above" FontSize="10" Foreground="#92AA90" VerticalAlignment="Center" Margin="14,0,0,0"/></StackPanel>
                                </StackPanel>
                                <Grid Grid.Column="1" Margin="0,12,16,15">
                                    <Ellipse Width="320" Height="320" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#48603B" StrokeThickness="1"/>
                                    <Ellipse Width="270" Height="270" HorizontalAlignment="Center" VerticalAlignment="Center"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#688447" Offset="0"/><GradientStop Color="#0040592F" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
                                    <Image Source="Art/pokey.png" Stretch="Uniform" MaxHeight="370" Margin="2,0,4,30" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Pokey, the pink spiky backyard monster"/>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom"><TextBlock Text="P O K E Y" Foreground="#E4BA71" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="SMALL MONSTER. BIG AMBITIONS." FontSize="8" Foreground="#A7BB94" Margin="0,6,0,0"/></StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="#172B23" BorderBrush="#304335" BorderThickness="1" CornerRadius="10" Padding="20,17" Margin="0,0,12,0"><StackPanel><TextBlock Text="01   /   READY ON YOUR PC" Style="{StaticResource Eyebrow}" Foreground="#B1CA98"/><TextBlock Text="Your monsters, kept close" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,7"/><TextBlock Text="Bundled art and game assets load locally." FontSize="11" Foreground="#91A68E" TextWrapping="Wrap"/></StackPanel></Border>
                            <Border Grid.Column="1" Background="#172B23" BorderBrush="#304335" BorderThickness="1" CornerRadius="10" Padding="20,17" Margin="0,0,12,0"><StackPanel><TextBlock Text="02   /   A PLACE TO RETURN" Style="{StaticResource Eyebrow}" Foreground="#E4BA71"/><TextBlock Text="Remember your realms" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,7"/><TextBlock Text="Save an address. Find it here next time." FontSize="11" Foreground="#91A68E" TextWrapping="Wrap"/></StackPanel></Border>
                            <Border Grid.Column="2" Background="#172B23" BorderBrush="#304335" BorderThickness="1" CornerRadius="10" Padding="20,17"><StackPanel><TextBlock Text="03   /   A LIVING BACKYARD" Style="{StaticResource Eyebrow}" Foreground="#B7B6D0"/><TextBlock Text="Join your world" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,7"/><TextBlock Text="Connect to your local or community server." FontSize="11" Foreground="#91A68E" TextWrapping="Wrap"/></StackPanel></Border>
                        </Grid>
                    </Grid>
                    </ScrollViewer>
                </Grid>
                <Grid x:Name="GamePanel" Visibility="Collapsed" Background="#101F1C"><wv2:WebView2 x:Name="GameView" DefaultBackgroundColor="#101F1C"/></Grid>
            </Grid>
            <Border Grid.Row="3" Background="#13251D" BorderBrush="#2D4031" BorderThickness="0,1,0,0">
                <Grid Margin="22,8,22,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="StatusText" Text="Ready. Choose a server and connect." FontSize="11" LineHeight="16"
                               Foreground="#9FB294" TextWrapping="Wrap" Margin="0,0,0,6"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                               AutomationProperties.LiveSetting="Polite"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ConnectionText" Text="Not connected" VerticalAlignment="Center" FontSize="10" Foreground="#A4B49A" Margin="0,0,22,0"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <TextBlock x:Name="PackStatusText" Grid.Column="1" Text="Checking local assets…" VerticalAlignment="Center" FontSize="10" Foreground="#91A68E"
                                   Margin="0,0,22,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <CheckBox x:Name="LocalAssetsToggle" Grid.Column="2" Content="Use local assets" IsChecked="True" VerticalAlignment="Center"
                                  Click="LocalAssets_Click" ToolTip="Use bundled assets. Turn off if a newer server needs different files, then reload."/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
