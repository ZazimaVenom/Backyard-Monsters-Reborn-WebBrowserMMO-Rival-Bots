<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BackyardMonstersClient</AssemblyName>
    <RootNamespace>BackyardMonsters.Client</RootNamespace>
    <Version>1.1.0</Version>
    <Product>Backyard Monsters Reborn Client</Product>
    <Description>Local asset client for Backyard Monsters Reborn</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Art/app.ico')">Art/app.ico</ApplicationIcon>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Client.Core/Client.Core.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
    <Resource Include="Art/*" />
  </ItemGroup>
</Project>
